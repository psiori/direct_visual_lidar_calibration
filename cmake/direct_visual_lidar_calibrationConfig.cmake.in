@PACKAGE_INIT@

include_guard()

set(BUILD_VLCAL_ALIGN @BUILD_VLCAL_ALIGN@)
set(BUILD_VLCAL_PREPROCESS @BUILD_VLCAL_PREPROCESS@)
set(BUILD_WITH_VIEWER @BUILD_WITH_VIEWER@)

include(CMakeFindDependencyMacro)

if(BUILD_VLCAL_ALIGN)
  find_dependency(Ceres REQUIRED)
  find_dependency(OpenCV REQUIRED COMPONENTS core imgproc)
  find_dependency(Eigen3 REQUIRED)
  find_dependency(Boost REQUIRED COMPONENTS filesystem)
endif()

if(BUILD_VLCAL_PREPROCESS)
  find_dependency(PCL REQUIRED)
  find_dependency(GTSAM REQUIRED)
  find_dependency(fmt REQUIRED)
  find_dependency(Boost REQUIRED COMPONENTS filesystem program_options date_time)
endif()

if(BUILD_WITH_VIEWER)
  find_dependency(Iridescence REQUIRED)
  find_dependency(OpenCV REQUIRED COMPONENTS core highgui imgproc)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")
check_required_components("@PROJECT_NAME@")
